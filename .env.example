# Optional absolute path to the local Tesseract executable.
# When omitted, the backend looks for `tesseract` on PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Comma-separated browser origins allowed to call the backend.
# Defaults to the two local Vite origins when this variable is unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
